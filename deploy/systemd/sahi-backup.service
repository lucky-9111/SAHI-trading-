[Unit]
Description=SAHI Trading - verified SQLite backup
After=sahi-backend.service

[Service]
Type=oneshot
User=sahi
Group=sahi
ExecStart=/usr/local/sbin/sahi-backup daily
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sahi /var/backups/sahi
