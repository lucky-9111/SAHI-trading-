# /etc/sahi/sahi.env - production runtime configuration for the backend (systemd EnvironmentFile).
# Owner root:sahi, mode 0640. NEVER commit the real file. Values are read literally (no quotes, no $ expansion).
# After editing: sudo systemctl restart sahi-backend

ENVIRONMENT=production
# Absolute path, outside every release directory. Deploys never touch this file.
DATABASE_URL=sqlite:////var/lib/sahi/sahi.db
# 64 random characters: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it logs every user out (their tokens become invalid).
SECRET_KEY=replace-with-64-random-characters
# Public origin(s) of the site and the host name(s) / IP the browser uses. No '*' in production.
CORS_ORIGINS=http://YOUR_PUBLIC_IP_OR_DOMAIN
TRUSTED_HOSTS=YOUR_PUBLIC_IP_OR_DOMAIN

# Market data: live = Angel One websocket, off = no live pipeline (REST fallback only)
FEED_MODE=live
PAPER_SLIPPAGE_PCT=0
# fill against live 5-level bid/ask depth (partial fills when visible size is short); false = full fill at LTP
PAPER_DEPTH_FILLS=true
INTRADAY_SQUAREOFF_MINUTES_BEFORE_CLOSE=0

# Angel One SmartAPI - market data only (the app is paper trading; it never places broker orders).
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
