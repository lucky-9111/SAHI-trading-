# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./agroup_trader.db
SECRET_KEY=generate-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# Angel One SmartAPI (same values you use in your scanner app)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# Angel One now logs in with your 4-digit MPIN, not the old password. Put the MPIN here.
ANGEL_PASSWORD=
# The TOTP secret string shown when you enable TOTP (not the 6-digit code)
ANGEL_TOTP_SECRET=
