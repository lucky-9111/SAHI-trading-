# Local development settings. Copy to backend/.env (never commit .env).
# Production uses /etc/sahi/sahi.env on the server instead - template: deploy/server/sahi.env.example

ENVIRONMENT=development
DATABASE_URL=sqlite:///./agroup_trader.db
# any long random string; production refuses defaults and anything under 32 characters
SECRET_KEY=generate-a-long-random-string
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=*
# live = Angel One websocket | replay = recorded ticks (REPLAY_FILE) | off = no live pipeline
FEED_MODE=live

# Angel One SmartAPI (market data only - the app is paper trading and never places broker orders)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
