# Server-side files must keep LF line endings even when checked out on Windows (core.autocrlf):
# bash, systemd, nginx and sudo reject or misread CRLF.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.lock          text eol=lf
deploy/**       text eol=lf
.github/**      text eol=lf
